# Analyse SonarQube advisory de `main` (D-16), unité utilisateur de kfzserver.
#
# Seul `main` est analysé : le clone ~/prosperity-sonar est en lecture seule sur le dépôt public
# (aucun jeton GitHub sur kfzserver) et ne récupère que `origin main`. Jamais une PR, un fork ni une
# branche de travail sur le homelab (D-13). Le jeton Sonar vient du fichier d'environnement hors
# dépôt (0600) ; l'adresse du serveur y est aussi (`SONAR_HOST_URL=http://localhost:9000`, boucle locale).
# Le chemin de `mise` est celui de son installeur officiel : à adapter si besoin.
[Unit]
Description=Analyse SonarQube advisory de main (Prosperity, D-16)

[Service]
Type=oneshot
WorkingDirectory=%h/prosperity-sonar
EnvironmentFile=%h/.config/prosperity-sonar/env
# Sur kfzserver le scanner tourne localement, pas par SSH.
Environment=SONAR_MODE=local
TimeoutStartSec=1h
Nice=10
# Pas de NoNewPrivileges= : un Podman sans privilèges a besoin de newuidmap.
ExecStart=/usr/bin/git fetch --no-tags --prune origin main
ExecStart=/usr/bin/git checkout --detach --force origin/main
ExecStart=/usr/bin/git clean -fd
ExecStart=%h/.local/bin/mise install --locked
ExecStart=%h/.local/bin/mise exec -- pnpm install --frozen-lockfile
ExecStart=%h/.local/bin/mise exec -- pnpm sonar
