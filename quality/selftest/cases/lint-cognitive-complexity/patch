@@ -0,0 +1,21 @@
+export function classify(a: number, b: number, c: number): string {
+  if (a > 0) {
+    if (b > 0) {
+      if (c > 0) {
+        return 'ppp';
+      }
+      return 'pp';
+    }
+    if (c > 0) {
+      return 'p0p';
+    }
+    return 'p';
+  }
+  if (b > 0) {
+    if (c > 0) {
+      return 'np';
+    }
+    return 'n';
+  }
+  return c > 0 ? 'c' : 'none';
+}
